        background: linear-gradient(135deg, #FFD700 0%, #FFC107 50%, #FFB700 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .gradient-border {
        position: relative;
        background: var(--bg-card);
    }
    
    .gradient-border::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(135deg, rgba(255,215,0,0.5), rgba(255,215,0,0.1));
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
    }
    
    .nav-link {
        position: relative;
        transition: all 0.3s ease;
    }
    
    .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--accent);
        transition: width 0.3s ease;
    }
    
    .nav-link:hover::after,
    .nav-link.active::after {
        width: 100%;
    }
    
    .nav-link.active {
        color: var(--accent) !important;
    }
    
    .page-section {
        display: none;
        animation: fadeInUp 0.5s ease;
    }
    
    .page-section.active {
        display: block;
    }
    
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }
    
    .floating {
        animation: float 6s ease-in-out infinite;
    }
    
    .music-bar {
        animation: musicBar 1s ease-in-out infinite;
    }
    
    @keyframes musicBar {
        0%, 100% { transform: scaleY(0.5); }
        50% { transform: scaleY(1); }
    }
    
    .music-bar:nth-child(2) { animation-delay: 0.1s; }
    .music-bar:nth-child(3) { animation-delay: 0.2s; }
    .music-bar:nth-child(4) { animation-delay: 0.3s; }
    .music-bar:nth-child(5) { animation-delay: 0.4s; }
    
