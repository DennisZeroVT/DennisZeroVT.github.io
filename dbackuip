        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .glow-hover:hover {
        box-shadow: 0 0 30px var(--accent-glow), 0 0 60px var(--accent-glow);
        transform: translateY(-4px);
        border-color: rgba(255, 215, 0, 0.4);
    }
    
