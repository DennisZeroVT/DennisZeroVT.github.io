function updateTabletViz() {
  const full = TABLET.full;
  const act = TABLET.active;
  const ratioFull = (full.w / full.h).toFixed(2);
  const ratioAct = (act.w / act.h).toFixed(4);
  
  const modelEl = document.getElementById('tablet-model');
  const specsEl = document.getElementById('tablet-specs');
  if (modelEl) modelEl.textContent = TABLET.model + ' — area';
  if (specsEl) specsEl.textContent = 'Full: ' + full.w + '×' + full.h + 'mm (' + ratioFull + ') • Active: ' + act.w + '×' + act.h + 'mm (' + ratioAct + ')';
  
  const viz = document.getElementById('tablet-viz');
  if (!viz) return;
  
  const scale = 240 / full.w;
  const actW = act.w * scale;
  const actH = act.h * scale;
  const offsetX = (act.x || 0) * scale;
  const offsetY = (full.h - act.h - (act.y || 0)) * scale;
  
  viz.innerHTML = '<div class="absolute inset-0 border-2 border-white/70"></div>' +
    '<div class="absolute -top-5 left-1/2 -translate-x-1/2 text-[10px] text-white/70 font-mono">' + full.w + 'mm</div>' +
    '<div class="absolute -left-8 top-1/2 -translate-y-1/2 -rotate-90 text-[10px] text-white/70 font-mono">' + full.h + 'mm</div>' +
    '<div class="absolute bg-[#FFD700]" style="width:' + actW + 'px; height:' + actH + 'px; left:' + offsetX + 'px; bottom:' + offsetY + 'px;">' +
      '<div class="absolute -top-4 left-1/2 -translate-x-1/2 text-[9px] text-black/70 font-mono">' + act.w + 'mm</div>' +
      '<div class="absolute -left-6 top-1/2 -translate-y-1/2 -rotate-90 text-[9px] text-black/70 font-mono">' + act.h + 'mm</div>' +
      '<div class="absolute inset-0 flex flex-col items-center justify-center">' +
        '<div class="w-1 h-1 bg-black rounded-full mb-0.5"></div>' +
        '<div class="text-[10px] text-black font-mono font-bold">' + ratioAct + '</div>' +
      '</div>' +
    '</div>';
}

